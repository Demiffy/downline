[configuration]

entry_symbol = "downline_init"
compatibility_minimum = "4.5"

[libraries]

macos.debug = "res://bin/libdownline.macos.template_debug.framework"
macos.release = "res://bin/libdownline.macos.template_release.framework"
windows.debug.x86_64 = "res://bin/libdownline.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libdownline.windows.template_release.x86_64.dll"
